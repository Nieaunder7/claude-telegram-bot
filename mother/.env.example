# Mother Bot Configuration

# Mother bot's own Telegram token (from @BotFather)
MOTHER_BOT_TOKEN=your_mother_bot_token_here

# Telegram user IDs allowed to control the mother bot
MOTHER_ALLOWED_USERS=your_telegram_user_id

# Default allowed users for child bot instances
DEFAULT_ALLOWED_USERS=your_telegram_user_id

# OpenAI API key (shared with child instances for voice transcription)
OPENAI_API_KEY=sk-...

# Base directory for cloned repositories (default: ~/repos)
# CLONE_BASE_DIR=/home/yourname/repos
